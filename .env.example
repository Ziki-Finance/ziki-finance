PORT=3000
HOST=127.0.0.1
# Without a key the application serves clearly labelled, fictional sample data.
FINNHUB_API_KEY=
# Optional shared secret for a remotely hosted daily refresh endpoint.
CRON_SECRET=
# Enabled by default; set false when running multiple replicas, and use external cron instead.
DAILY_BRIEFING_ENABLED=true
DATA_DIRECTORY=./data
